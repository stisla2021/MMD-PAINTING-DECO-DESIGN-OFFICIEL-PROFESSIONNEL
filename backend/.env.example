PORT=3000
NODE_ENV=development
# Comma-separated frontend origins; update this for the deployed website.
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
# Set a long, unique secret before using the admin work-upload page.
ADMIN_API_KEY=replace-this-with-a-long-random-secret
