{
  "$schema": "https://developers.cloudflare.com/schemas/wrangler.json",
  "name": "mmd-painting-deco-design",
  "pages_build_output_dir": "./Front-end",
  "compatibility_date": "2026-11-09",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mmd-painting-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "WORK_IMAGES",
      "bucket_name": "mmd-painting-uploads"
    }
  ]
}
