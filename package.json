{
  "name": "mmd-painting-deco-design",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "test:cloudflare": "node --test cloudflare/test/pages-functions.test.js",
    "cloudflare:db:create": "wrangler d1 create mmd-painting-db --update-config",
    "cloudflare:r2:create": "wrangler r2 bucket create mmd-painting-uploads",
    "cloudflare:migrate": "wrangler d1 migrations apply mmd-painting-db --remote",
    "cloudflare:deploy": "wrangler pages deploy Front-end --project-name mmd-painting-deco-design"
  },
  "devDependencies": {
    "wrangler": "^4.158.0"
  }
}
